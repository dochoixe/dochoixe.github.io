<!DOCTYPE html>
<html lang="vi">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1, viewport-fit=cover">
  <title>Trăng gửi lời thương 🌕</title>

  <style>
    * {
      box-sizing: border-box;
    }

    :root {
      color-scheme: dark;
      --gold: #ffd580;
      --cream: #fff5db;
    }

    body {
      margin: 0;
      min-height: 100svh;
      overflow-x: hidden;
      color: var(--cream);
      font-family: Arial, sans-serif;
      background:
        radial-gradient(circle at 75% 25%, #28545c 0, transparent 40%),
        linear-gradient(145deg, #061b2c, #123e48);
    }

    button {
      font: inherit;
      cursor: pointer;
    }

    button:focus-visible,
    a:focus-visible {
      outline: 3px solid white;
      outline-offset: 6px;
    }

    .stars {
      position: fixed;
      inset: 0;
      overflow: hidden;
      pointer-events: none;
    }

    .star {
      position: absolute;
      color: #ffe7ab;
      animation: twinkle 3s infinite alternate;
    }

    .lantern {
      position: absolute;
      top: 20px;
      font-size: clamp(45px, 8vw, 85px);
      transform-origin: top center;
      animation: sway 4s ease-in-out infinite;
    }

    .lantern.left {
      left: 7%;
    }

    .lantern.right {
      right: 7%;
      animation-delay: -2s;
    }

    main {
      position: relative;
      width: min(1080px, 100%);
      min-height: 100svh;
      margin: auto;
      padding: 100px 24px 35px;
      display: flex;
      flex-direction: column;
      align-items: center;
      justify-content: center;
      text-align: center;
    }

    .eyebrow {
      color: var(--gold);
      font-size: 12px;
      letter-spacing: 4px;
      line-height: 1.8;
    }

    h1 {
      margin: 16px 0;
      font-family: Georgia, "Times New Roman", serif;
      font-size: clamp(42px, 8vw, 80px);
      font-weight: normal;
      line-height: 1.15;
    }

    h1 span {
      color: var(--gold);
      font-style: italic;
    }

    .description {
      max-width: 500px;
      margin: 0;
      color: #d2e3e6;
      font-size: 17px;
      line-height: 1.8;
    }

    .illustration {
      position: relative;
      width: 290px;
      height: 260px;
      margin: 15px 0;
    }

    .moon-button {
      position: absolute;
      top: 0;
      left: 45px;
      padding: 0;
      border: none;
      background: none;
      font-size: 175px;
      line-height: 1.25;
      filter: drop-shadow(0 0 35px #ffd58055);
      transition: transform 0.3s;
    }

    .moon-button:hover {
      transform: scale(1.08) rotate(-5deg);
    }

    .rabbit {
      position: absolute;
      bottom: 10px;
      right: 12px;
      font-size: 86px;
      pointer-events: none;
      animation: float 3s ease-in-out infinite;
    }

    .cake {
      position: absolute;
      bottom: 12px;
      left: 28px;
      font-size: 63px;
      pointer-events: none;
    }

    .primary {
      display: inline-flex;
      align-items: center;
      justify-content: center;
      gap: 12px;
      min-height: 54px;
      padding: 16px 25px;
      border: none;
      border-radius: 999px;
      background: var(--gold);
      color: #15323e;
      font-weight: bold;
      box-shadow: 0 8px 30px #ffd58020;
      transition: transform 0.2s, background 0.2s;
    }

    .primary:hover {
      transform: translateY(-3px);
      background: #ffe4ad;
    }

    .hint {
      margin-top: 18px;
      color: #b6ced3;
      font-size: 14px;
    }

    footer {
      margin-top: 45px;
      color: #b6ced3;
      font-size: 14px;
      line-height: 1.8;
    }

    dialog {
      position: fixed;
      width: min(520px, calc(100% - 32px));
      max-height: 90svh;
      overflow: auto;
      padding: 42px 28px 30px;
      border: 1px solid #ffd58066;
      border-radius: 24px;
      background:
        radial-gradient(circle at top, #245465, transparent 65%),
        #102d3e;
      color: var(--cream);
      text-align: center;
      box-shadow: 0 25px 100px #0008;
    }

    dialog::backdrop {
      background: #03111dcc;
      backdrop-filter: blur(8px);
    }

    dialog[open] {
      animation: appear 0.35s ease-out;
    }

    .close {
      position: absolute;
      top: 10px;
      right: 14px;
      width: 42px;
      height: 42px;
      border: none;
      background: transparent;
      color: white;
      font-size: 30px;
    }

    .card-icon {
      margin: 0;
      font-size: 60px;
    }

    h2 {
      color: var(--gold);
      font-family: Georgia, "Times New Roman", serif;
      font-size: 32px;
      font-weight: normal;
    }

    #wishText {
      margin: 22px 0;
      font-size: 21px;
      line-height: 1.85;
      overflow-wrap: anywhere;
    }

    .divider {
      margin: 22px 0;
      color: var(--gold);
      letter-spacing: 10px;
    }

    #notice {
      min-height: 20px;
      margin-bottom: 0;
      color: #c4dadd;
      font-size: 14px;
    }

    .confetti {
      position: fixed;
      z-index: 10;
      pointer-events: none;
      animation: burst 1.3s ease-out forwards;
    }

    @keyframes twinkle {
      from { opacity: 0.2; }
      to { opacity: 1; }
    }

    @keyframes sway {
      0%, 100% { transform: rotate(-8deg); }
      50% { transform: rotate(8deg); }
    }

    @keyframes float {
      0%, 100% { transform: translateY(0); }
      50% { transform: translateY(-10px); }
    }

    @keyframes appear {
      from {
        opacity: 0;
        transform: translateY(20px) scale(0.95);
      }
      to {
        opacity: 1;
        transform: none;
      }
    }

    @keyframes burst {
      to {
        transform: translate(var(--x), var(--y)) rotate(150deg);
        opacity: 0;
      }
    }

    @media (max-width: 480px) {
      main {
        padding-top: 105px;
      }

      .eyebrow {
        font-size: 11px;
        letter-spacing: 2px;
      }

      .description {
        font-size: 16px;
      }

      #wishText {
        font-size: 19px;
      }
    }

    @media (prefers-reduced-motion: reduce) {
      *, *::before, *::after {
        animation: none !important;
        transition: none !important;
      }
    }
/* Tối ưu điện thoại và vùng an toàn trên iPhone */
html {
  -webkit-text-size-adjust: 100%;
}

body {
  min-width: 280px;
}

button {
  touch-action: manipulation;
  -webkit-tap-highlight-color: transparent;
}

main {
  padding-bottom: max(28px, env(safe-area-inset-bottom));
}

dialog {
  overscroll-behavior: contain;
}

body:has(dialog[open]) {
  overflow: hidden;
}

/* Điện thoại */
@media (max-width: 600px) {
  main {
    min-height: 100svh;
    padding:
      max(76px, env(safe-area-inset-top))
      20px
      max(24px, env(safe-area-inset-bottom));
    justify-content: center;
  }

  .lantern {
    top: max(12px, env(safe-area-inset-top));
    font-size: 44px;
  }

  .lantern.left {
    left: 16px;
  }

  .lantern.right {
    right: 16px;
  }

  .eyebrow {
    max-width: 260px;
    font-size: 12px;
    letter-spacing: 2px;
    line-height: 1.7;
  }

  h1 {
    margin: 14px 0;
    font-size: clamp(2.5rem, 11vw, 3.5rem);
    line-height: 1.15;
  }

  .description {
    max-width: 340px;
    font-size: 16px;
    line-height: 1.7;
    text-wrap: pretty;
  }

  .illustration {
    width: 240px;
    height: 205px;
    margin: 14px 0;
    flex-shrink: 0;
  }

  .moon-button {
    top: 0;
    left: 40px;
    font-size: 140px;
    min-width: 160px;
    min-height: 160px;
  }

  .rabbit {
    right: 5px;
    bottom: 5px;
    font-size: 70px;
  }

  .cake {
    left: 20px;
    bottom: 5px;
    font-size: 52px;
  }

  .primary {
    width: 100%;
    max-width: 360px;
    min-height: 56px;
    padding: 16px 18px;
    font-size: 16px;
    line-height: 1.4;
    white-space: normal;
  }

  .hint {
    max-width: 320px;
    margin: 14px 0 0;
    font-size: 14px;
    line-height: 1.6;
  }

  footer {
    margin-top: 26px;
    font-size: 14px;
    line-height: 1.7;
  }

  /* Thiệp lời chúc */
  dialog {
    width: calc(100% - 28px);
    max-width: 420px;
    max-height: 86vh;
    max-height: 86dvh;
    margin: auto;
    padding: 48px 22px 24px;
    border-radius: 22px;
    overflow-y: auto;
  }

  .close {
    top: 8px;
    right: 8px;
    width: 44px;
    height: 44px;
    display: grid;
    place-items: center;
    padding: 0;
    line-height: 1;
  }

  .card-icon {
    font-size: 48px;
    line-height: 1.3;
  }

  h2 {
    margin: 18px 0;
    font-size: clamp(1.5rem, 7vw, 1.875rem);
    line-height: 1.3;
    text-wrap: balance;
  }

  #wishText {
    margin: 18px 0;
    font-size: 18px;
    line-height: 1.8;
    text-wrap: pretty;
  }

  .divider {
    margin: 20px 0;
  }

  #notice {
    margin-top: 16px;
    font-size: 14px;
    line-height: 1.6;
  }
}

/* Điện thoại có màn hình thấp */
@media (max-width: 600px) and (max-height: 740px) {
  main {
    padding-top: max(65px, env(safe-area-inset-top));
  }

  h1 {
    margin: 10px 0;
    font-size: 2.5rem;
  }

  .illustration {
    height: 170px;
    margin: 8px 0;
  }

  .moon-button {
    left: 52px;
    font-size: 115px;
    min-width: 140px;
    min-height: 140px;
  }

  .rabbit {
    right: 20px;
    font-size: 60px;
  }

  .cake {
    left: 30px;
    font-size: 46px;
  }

  footer {
    margin-top: 18px;
  }
}

/* Khi xoay ngang điện thoại */
@media (max-height: 500px) and (orientation: landscape) {
  main {
    min-height: 100svh;
    padding-top: 35px;
    padding-bottom: 24px;
  }

  .lantern {
    font-size: 38px;
  }

  .illustration {
    margin: 6px 0;
  }

  dialog {
    max-height: 90dvh;
  }
}

/* Thiết bị cảm ứng: tránh hiệu ứng hover bị giữ sau khi chạm */
@media (hover: none) {
  .primary:hover,
  .moon-button:hover {
    transform: none;
  }

  .primary:active {
    transform: scale(0.97);
  }

  .moon-button:active {
    transform: scale(0.95);
  }
}
  </style>
</head>

<body>
  <div class="stars" id="stars" aria-hidden="true"></div>

  <div class="lantern left" aria-hidden="true">🏮</div>
  <div class="lantern right" aria-hidden="true">🏮</div>

  <main>
    <div class="eyebrow">RẰM THÁNG TÁM · MÙA ĐOÀN VIÊN</div>

    <h1>Trăng gửi<br><span>lời thương.</span></h1>

    <p class="description">
      Có một lời chúc đang chờ bạn.<br>
      Chạm vào trăng để nhận một chút ngọt ngào nhé!
    </p>

    <div class="illustration">
      <button
        class="moon-button"
        id="moonButton"
        aria-label="Chạm vào trăng để nhận lời chúc"
      >🌕</button>

      <span class="rabbit" aria-hidden="true">🐇</span>
      <span class="cake" aria-hidden="true">🥮</span>
    </div>

    <button class="primary" id="openButton">
      ✨ Mở lời chúc của bạn
    </button>

    <p class="hint">Mỗi lần chạm, một niềm vui nho nhỏ.</p>

    <footer>
      Chúc bạn một mùa Trung thu an yên.<br>
      Trăng tròn, tình thân cũng tròn. 💛
    </footer>
  </main>

  <dialog id="wishDialog" aria-labelledby="cardTitle">
    <button class="close" id="closeButton" aria-label="Đóng">×</button>

    <p class="card-icon" aria-hidden="true">🏮🐇🥮</p>
    <h2 id="cardTitle">Một lời thương gửi bạn</h2>

    <p id="wishText" aria-live="polite"></p>

    <div class="divider" aria-hidden="true">✦ ✧ ✦</div>

    <button class="primary" id="nextButton">
      🎁 Mở thêm lời chúc
    </button>

    <p id="notice" role="status"></p>
  </dialog>

  <script>
    /*
      LẤY LỜI CHÚC TỪ ĐƯỜNG LINK:

      Nếu có file JSON cùng thư mục, đổi thành:
      const WISHES_URL = "./trung-thu-wishes.json";

      Hoặc dùng link HTTPS trỏ trực tiếp đến danh sách JSON.
      Link ngoài phải cho phép CORS.

      Để trống thì dùng 20 câu có sẵn bên dưới.
    */
  const WISHES_URL = "./trung-thu-wishes.json";

    const DEFAULT_WISHES = [
      "Chúc bạn một mùa Trung thu an yên, có người để thương, có nhà để về và có thật nhiều niềm vui để nhớ.",
      "Mong mọi điều tốt đẹp đến với bạn đều tròn đầy như vầng trăng đêm nay. Trung thu vui vẻ nhé!",
      "Chúc bạn bánh ngon đầy đĩa, tiếng cười đầy nhà và yêu thương đầy tim.",
      "Trăng hôm nay thật sáng. Mong những ngày sắp tới của bạn cũng rạng rỡ như vậy.",
      "Gửi bạn một chiếc ôm qua ánh trăng. Dù ở đâu, mong bạn luôn cảm thấy mình được yêu thương.",
      "Chúc gia đình bạn một đêm đoàn viên ấm áp, cùng uống trà, ăn bánh và kể nhau nghe những chuyện thật vui.",
      "Mong bạn giữ được một chút hồn nhiên để mỗi mùa trăng về, lòng vẫn háo hức như ngày còn bé.",
      "Trung thu này, chúc bạn bớt lo một chút, cười nhiều một chút và thương bản thân thêm thật nhiều.",
      "Chúc những dự định còn dang dở của bạn sớm thành hình, những điều chờ đợi sớm có hồi âm.",
      "Chúc bạn một tối bình yên, một miếng bánh ngon và một người thương ngồi cạnh.",
      "Thỏ ngọc nhờ mình nhắn bạn: hôm nay hãy vui lên nhé, bạn xứng đáng với những điều ngọt ngào.",
      "Chúc bạn nhận được nhiều niềm vui hơn cả số hạt sen trong hộp bánh Trung thu!",
      "Mong ánh trăng dẫn những điều dịu dàng đến bên bạn, để cả những ngày bận rộn cũng có một góc bình yên.",
      "Chúc bạn đi xa vẫn có người mong, trở về vẫn có người đợi. Trung thu trọn vẹn yêu thương!",
      "Đêm nay trăng tròn rồi, chúc túi tiền của bạn cũng sớm đầy, còn nỗi buồn thì vơi hết nhé!",
      "Chúc mùa trăng này mang đến một cuộc gặp đáng nhớ, một tin vui bất ngờ và thật nhiều tiếng cười.",
      "Mong bạn luôn có đủ can đảm để theo đuổi ước mơ và đủ dịu dàng để chăm sóc chính mình.",
      "Gửi một chút ánh trăng vào lời chúc nhỏ: mong bạn và những người thân yêu luôn khỏe mạnh, bình an.",
      "Chúc bạn một mùa Trung thu ngọt như bánh, ấm như trà và đẹp như những kỷ niệm tuổi thơ.",
      "Nếu hôm nay chưa thật vui, mong lời chúc này khiến bạn mỉm cười. Những điều tốt lành đang chờ bạn phía trước."
    ];

    let wishes = [...DEFAULT_WISHES];
    let remaining = [];
    let lastWish = "";
    let opened = 0;

    const dialog = document.getElementById("wishDialog");
    const wishText = document.getElementById("wishText");
    const notice = document.getElementById("notice");

    // Xáo trộn để không lặp câu cho đến khi xem hết danh sách.
    function getRandomWish() {
      if (remaining.length === 0) {
        remaining = [...wishes];

        for (let i = remaining.length - 1; i > 0; i--) {
          const j = Math.floor(Math.random() * (i + 1));

          [remaining[i], remaining[j]] =
            [remaining[j], remaining[i]];
        }

        // Tránh lặp ngay câu cuối của lượt trước.
        const end = remaining.length - 1;

        if (remaining.length > 1 && remaining[end] === lastWish) {
          [remaining[0], remaining[end]] =
            [remaining[end], remaining[0]];
        }
      }

      lastWish = remaining.pop();
      return lastWish;
    }

    function makeSparkles() {
      if (window.matchMedia("(prefers-reduced-motion: reduce)").matches) {
        return;
      }

      const symbols = ["✨", "⭐", "💛", "🌟"];

      for (let i = 0; i < 16; i++) {
        const particle = document.createElement("span");

        particle.className = "confetti";
        particle.textContent = symbols[i % symbols.length];
        particle.setAttribute("aria-hidden", "true");

        particle.style.left = "50%";
        particle.style.top = "45%";
        particle.style.fontSize = `${16 + Math.random() * 18}px`;
        particle.style.setProperty("--x", `${(Math.random() - 0.5) * 520}px`);
        particle.style.setProperty("--y", `${(Math.random() - 0.5) * 500}px`);

        // Đặt trong dialog để hiệu ứng hiện trên thiệp.
        dialog.appendChild(particle);

        setTimeout(() => particle.remove(), 1400);
      }
    }

    function openWish() {
      wishText.textContent = getRandomWish();
      opened++;

      notice.textContent = `Bạn đã mở ${opened} lời chúc 💛`;

      if (!dialog.open) {
        dialog.showModal();
      }

      makeSparkles();
    }

    document.getElementById("openButton").onclick = openWish;
    document.getElementById("moonButton").onclick = openWish;
    document.getElementById("nextButton").onclick = openWish;

    document.getElementById("closeButton").onclick = () => {
      dialog.close();
    };

    // Nhấn vùng bên ngoài thiệp để đóng.
    dialog.addEventListener("click", (event) => {
      if (event.target !== dialog) return;

      const box = dialog.getBoundingClientRect();

      if (
        event.clientX < box.left ||
        event.clientX > box.right ||
        event.clientY < box.top ||
        event.clientY > box.bottom
      ) {
        dialog.close();
      }
    });

    // Tạo các ngôi sao trang trí.
    const stars = document.getElementById("stars");

    for (let i = 0; i < 38; i++) {
      const star = document.createElement("span");

      star.className = "star";
      star.textContent = i % 3 === 0 ? "✦" : "·";
      star.style.left = `${Math.random() * 100}%`;
      star.style.top = `${Math.random() * 100}%`;
      star.style.fontSize = `${10 + Math.random() * 16}px`;
      star.style.animationDelay = `${Math.random() * 3}s`;

      stars.appendChild(star);
    }

    // Nếu có link, tải danh sách trước khi cho mở lời chúc.
    async function loadWishes() {
      if (!WISHES_URL.trim()) return;

      const openButton = document.getElementById("openButton");
      const moonButton = document.getElementById("moonButton");
      const originalText = openButton.textContent;

      openButton.disabled = true;
      moonButton.disabled = true;
      openButton.textContent = "Đang chuẩn bị lời chúc…";

      const controller = new AbortController();
      const timer = setTimeout(() => controller.abort(), 8000);

      try {
        const response = await fetch(WISHES_URL, {
          signal: controller.signal,
          credentials: "omit"
        });

        if (!response.ok) {
          throw new Error("Không tải được danh sách");
        }

        const data = await response.json();

        if (
          !Array.isArray(data) ||
          data.length === 0 ||
          data.length > 2000 ||
          !data.every(item =>
            typeof item === "string" &&
            item.trim().length > 0 &&
            item.length <= 2000
          )
        ) {
          throw new Error("Danh sách JSON không đúng định dạng");
        }

        wishes = [...new Set(data.map(item => item.trim()))];
        remaining = [];
      } catch (error) {
        // Link lỗi thì trang vẫn hoạt động với bộ có sẵn.
        console.warn("Đang dùng lời chúc có sẵn:", error.message);
      } finally {
        clearTimeout(timer);
        openButton.disabled = false;
        moonButton.disabled = false;
        openButton.textContent = originalText;
      }
    }

    loadWishes();
  </script>
</body>
</html>
